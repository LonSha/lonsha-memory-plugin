{
  "name": "lonsha-memory-plugin",
  "version": "3.430.0",
  "private": true,
  "description": "SillyTavern memory plugin (graph / vector / timeline). Shipped as a CJS+IIFE bundle - do not add type:module.",
  "scripts": {
    "test": "node tests/run.mjs",
    "test:serial": "node tests/run.mjs --serial",
    "test:audit": "node tests/run.mjs --audit",
    "drill:unload": "node tools/drill_unload.mjs",
    "drill:unload:json": "node tools/drill_unload.mjs --json",
    "drill:unload:selftest": "node tools/drill_unload.mjs --selftest",
    "index:defects": "python3 tools/gen_defect_index.py"
  }
}
