*.bak
node_modules/
*.log

# [v3.146] One-off repo-edit scripts (sNN/uN/vN/wN/fixN.py) and debug dumps.
# Kept out so a blanket `git add -A` can never stage them.
/[suvwf][0-9]*.py
/[a-z]*fix[0-9]*.py
/dbg*.js
/tmp_*.js

# [v3.267.0 A1 第七刀] Rebuild tooling retains source extraction but no generated payloads.
/tools/_v3267_*
/tools/__pycache__/
/tools/patch_v3267_*.py
# Release package output (built by tools/release_zip.py; attached to GitHub releases, not committed)
dist/
.tmp/
# [v3.431.0] tests/run.mjs 的临时根落盘目录（本机 /tmp 是 tmpfs，回归镜像树
#   改落仓库同级磁盘目录；每条 run 一个 lonsha-run-* 子目录，收尾自动整棵删）
.lonsha-test-tmp/
